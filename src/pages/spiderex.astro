---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Spiderex" subtitle="Daily guitar fingering drills" description="Daily guitar fingering drills">
  <!-- Markup ported from the legacy page. The behaviour (vanilla TypeScript, Mulberry32 PRNG) and the move to
       /tools/spiderex/ with a redirect are handled by ticket #3, so the form is inert for now. -->
  <div data-spiderex>
    <form>
      <input type="date" name="date" placeholder="yyyy-mm-dd" aria-label="Date" data-spiderex-query />
      <input type="submit" value="Query Date" />
    </form>
    <section>
      <h2>Warmup</h2>
      <p>
        Play each pattern ascending &amp; descending across all strings, with straight &amp; triplet feel. Once you are
        comfortable with the patterns, phase in some string skipping.
      </p>
      <div data-spiderex-warmup-results></div>
    </section>
    <section>
      <h2>Twister</h2>
      <p>Built from the warmup patterns listed above.</p>
      <div data-spiderex-twister-results></div>
    </section>
  </div>
</BaseLayout>
