---
import '../styles/main.css';
// Base layout with anti-FOUC inline script, landmark navigation,
// accessible theme switcher, and shared footer.
interface Props {
  title: string;
  subtitle?: string;
  description: string;
  noindex?: boolean;
}
const { title, subtitle, description, noindex = false } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="kidthales" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          } else {
            const legacy = localStorage.getItem('app/theme/prefers-dark');
            if (legacy === 'true') document.documentElement.dataset.theme = 'dark';
            else if (legacy === 'false') document.documentElement.dataset.theme = 'light';
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a href="#mainContent">Skip to main content</a>
    <header>
      <nav>
        <ul>
          <li>
            <a href="/"><img src="/logo.png" alt="kidthales home" width="32" height="32" /></a>
          </li>
          <li><a href="/tools/">Tools</a></li>
          <li><a href="/pgmmv/">PGMMV</a></li>
        </ul>
        <ul>
          <li>
            <button
              type="button"
              class="theme-toggle"
              data-theme-toggle
              aria-label="Toggle colour theme"
            >
              Theme: <span data-theme-label>System</span>
            </button>
          </li>
        </ul>
      </nav>
    </header>
    <main id="mainContent">
      <header>
        <hgroup>
          <h1>{title}</h1>
          {subtitle && <p>{subtitle}</p>}
        </hgroup>
      </header>
      <slot />
    </main>
    <footer>
      <small>© 2024-{year} kidthales. All rights reserved.</small>
    </footer>
    <script src="../scripts/theme.ts"></script>
  </body>
</html>
